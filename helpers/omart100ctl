VENDOR = 0x3151
WIRED_PRODUCTS = (0x4010, 0x4015)
CONTROL_INTERFACE = 2
REPORT_LEN = 64
DATA_LEN = REPORT_LEN - 8
MAX_LED = 101                     # highest key light on an RT100

SCREEN_SIZE = (162, 173)          # width, height of a still picture
GIF_SIZE = (128, 160)             # largest animation size the firmware takes
GIF_MAX_FRAMES = 56
GIF_FRAME_MS = 66

ERASE_DELAY = 1.0                 # pause after an upload's first report
IMAGE_PACKET_DELAY = 0.005
KEY_ERASE_DELAY = 0.25
KEY_PACKET_DELAY = 0.010
KEY_FRAME_GAP = 1.0               # colour frames sent closer than this can
                                  # knock the RT100 back to plain white
FIELD_SPACING = 1.6               # the screen drops a value sent sooner

