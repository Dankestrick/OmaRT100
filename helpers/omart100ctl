# Device
# --------------------------------------------------------------------------- #

def _ioc_set_feature(length):
    # _IOC(_IOC_WRITE | _IOC_READ, 'H', 0x06, length)
    return (3 << 30) | (length << 16) | (ord("H") << 8) | 0x06


def _ioc_get_feature(length):
    # _IOC(_IOC_WRITE | _IOC_READ, 'H', 0x07, length)
    return (3 << 30) | (length << 16) | (ord("H") << 8) | 0x07


def find_control_node():
    """The /dev/hidraw node for interface 2 of a wired RT100, or None."""
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(os.path.join(node, "device", "uevent")) as fh:
                uevent = fh.read()
        except OSError:
            continue
        match = re.search(r"HID_ID=\w+:0*([0-9A-Fa-f]+):0*([0-9A-Fa-f]+)", uevent)
        if not match:
            continue
        vendor, product = int(match.group(1), 16), int(match.group(2), 16)
        if vendor != VENDOR or product not in WIRED_PRODUCTS:
            continue
        real = os.path.realpath(os.path.join(node, "device"))
        if re.search(r":1\.%d/" % CONTROL_INTERFACE, real + "/"):
            return "/dev/" + os.path.basename(node)
    return None


class Keyboard:
    def __init__(self, path):
        self.path = path
        self.fd = os.open(path, os.O_RDWR)

    def close(self):
        try:
            os.close(self.fd)
        except OSError:
            pass

    def send(self, report):
        buf = bytearray(report)
        if len(buf) != REPORT_LEN:
            raise ValueError("report must be %d bytes" % REPORT_LEN)
        fcntl.ioctl(self.fd, _ioc_set_feature(REPORT_LEN), buf)

    def exchange(self, header7, payload=b"", expect=None):
        """Send a command and read the keyboard's 64-byte reply."""
        for _attempt in range(3):
            self.send(_data_report(header7, payload))
            time.sleep(0.02)
            buf = bytearray(REPORT_LEN + 1)
            count = fcntl.ioctl(self.fd, _ioc_get_feature(len(buf)), buf, True)
            reply = bytes(buf[1:count]) if count == REPORT_LEN + 1 else bytes(buf[:count])
            if len(reply) == REPORT_LEN and (expect is None or reply[0] == expect):
                return reply
            time.sleep(0.1)
        raise OSError("The keyboard didn't answer.")

    def send_paced(self, reports, erase_delay, packet_delay, progress=None):
        total = len(reports)
        for index, report in enumerate(reports):
            self.send(report)
            if index == 0 and erase_delay:
                time.sleep(erase_delay)
            elif packet_delay:
                time.sleep(packet_delay)
            if progress and (index % 50 == 0 or index + 1 == total):
                progress(index + 1, total)


# --------------------------------------------------------------------------- #
# Reports
# --------------------------------------------------------------------------- #

def _pad(data):
    data = bytes(data)
    return data + bytes(REPORT_LEN - len(data))


def _checksum(header):
    return (0xFF - (sum(header) & 0xFF)) & 0xFF


def _data_report(header7, payload):
    header = bytes(header7)
    return _pad(header + bytes([_checksum(header)]) + bytes(payload))


def time_report(now=None):
    now = now or datetime.now()
    body = bytes.fromhex("28000000000000d7") + now.year.to_bytes(2, "big") + bytes(
        [now.month, now.day, now.hour, now.minute, now.second])
    return _pad(body)


def cpu_report(percent):
    return _pad(bytes.fromhex("22000000000000dd63007f0004000800") + bytes([percent]))


def temp_report(celsius):
    return _pad(bytes.fromhex("2a000000000000d5") + bytes([celsius]))


def key_reports(led_colors):
    """One static frame: {led index: (r, g, b)}; every other LED off."""
    data = bytearray(7 * DATA_LEN)
    for led, rgb in led_colors.items():
        for i, value in enumerate(rgb):
            pos = led * 3 + i
            if 0 <= pos < len(data):
                data[pos] = max(0, min(255, int(value)))
    reports = [_pad(bytes.fromhex("18000000000000e7"))]
    for part in range(7):
        header = bytes([0x19, part, 0, 1, 0, 0, 0])
        reports.append(_data_report(header, data[part * DATA_LEN:(part + 1) * DATA_LEN]))
    return reports


# The keyboard's built-in effects: (name, label, firmware mode, directions).
# Mode numbers from OpenRGB's EpomakerController.h via epomaker-controller.
EFFECTS = [
    ("always-on", "Always on", 0x01, 0),
    ("breathing", "Breathing", 0x02, 0),
    ("spectrum", "Spectrum cycle", 0x03, 0),
    ("drift", "Drift", 0x04, 4),
    ("ripple", "Ripple", 0x05, 0),
    ("twinkle", "Twinkle", 0x06, 0),
    ("stream", "Stream", 0x07, 2),
    ("shadowing", "Shadowing", 0x08, 0),
    ("peaks", "Peaks", 0x09, 0),
    ("sine", "Sine wave", 0x0A, 0),
    ("surge", "Surge", 0x0B, 2),
    ("bloom", "Bloom", 0x0C, 2),
    ("laser", "Laser", 0x0E, 0),
    ("spin", "Spin", 0x0F, 2),
    ("rain", "Rain", 0x10, 0),
    ("snow", "Snow", 0x11, 0),
    ("meteor", "Meteor", 0x12, 0),
    ("snow-trail", "Snow trail", 0x13, 0),
    ("light-shadow", "Light and shadow", 0x15, 0),
]
EFFECT_BY_NAME = {e[0]: e for e in EFFECTS}


def effect_report(name, speed=4, brightness=4, rainbow=False, direction=0, color="#ffffff"):
    _, _, mode, directions = EFFECT_BY_NAME[name]
    option = (min(int(direction), directions - 1) << 4) if directions else 0
    option |= 0x08 if rainbow else 0x07
    r, g, b = _rgb(color)
    body = bytes([0x07, mode, max(0, min(4, int(speed))), max(0, min(4, int(brightness))),
                  option, r, g, b])
    return _pad(body + bytes([_checksum(body)]))


def _rgb565_transposed(image):
    """Pixel bytes in the order the firmware reads them: column by column."""
    width, height = image.size
    pixels = image.load()
    out = bytearray(width * height * 2)
    pos = 0
    for x in range(width):
        for y in range(height):
            r, g, b = pixels[x, y][:3]
            value = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3)
            out[pos] = value >> 8
            out[pos + 1] = value & 0xFF
            pos += 2
    return bytes(out)


def upload_reports(frames, size, delay_ms):
    """Init report plus 0x38 data / 0x34 footer reports for each frame."""
    width, height = size
    per_frame = width * height * 2
    init = bytearray([0xA5, 0x00, len(frames) & 0xFF, min(delay_ms, 255),
                      per_frame & 0xFF, (per_frame >> 8) & 0xFF, 0x00])
    init.append(_checksum(init))
    init += bytes([0x00, 0x00, width & 0xFF, height & 0xFF])
    reports = [_pad(init)]
    per_report_count = -(-per_frame // DATA_LEN)
    for number, frame in enumerate(frames, start=1):
        raw = _rgb565_transposed(frame)
        for seq in range(per_report_count):
            kind = 0x34 if seq == per_report_count - 1 else 0x38
            header = bytes([0x25, 0x00, number & 0xFF, 0x00, seq & 0xFF, seq >> 8, kind])
            chunk = raw[seq * DATA_LEN:(seq + 1) * DATA_LEN]
            reports.append(_data_report(header, chunk + bytes(DATA_LEN - len(chunk))))
    return reports


# --------------------------------------------------------------------------- #
# Pictures
# --------------------------------------------------------------------------- #

def clean_place(place):
    """Zoom and shift chosen in the window. zoom 1 fills the screen; x and y
    move the picture by that share of the screen's width and height."""
    place = place if isinstance(place, dict) else {}
    def num(key, low, high, default):
        try:
            return max(low, min(high, float(place.get(key, default))))
        except (TypeError, ValueError):
            return default
    return {"zoom": num("zoom", 0.2, 5.0, 1.0), "x": num("x", -1.0, 1.0, 0.0),
            "y": num("y", -1.0, 1.0, 0.0)}


def _fit(image, size, place=None):
    """Scale to fill `size` (times zoom), centred, then shifted; bars are black."""
    from PIL import Image
    place = clean_place(place)
    image = image.convert("RGB")
    width, height = size
    scale = max(width / image.width, height / image.height) * place["zoom"]
    scaled = image.resize((max(1, round(image.width * scale)), max(1, round(image.height * scale))),
                          Image.LANCZOS)
    canvas = Image.new("RGB", size, (0, 0, 0))
    left = round((width - scaled.width) / 2 + place["x"] * width)
    top = round((height - scaled.height) / 2 + place["y"] * height)
    canvas.paste(scaled, (left, top))
    return canvas


def still_reports(path, place=None):
    from PIL import Image
    with Image.open(path) as image:
        image.seek(0)
        return upload_reports([_fit(image, SCREEN_SIZE, place)], SCREEN_SIZE, 0)


def gif_reports(path, place=None):
    from PIL import Image
    with Image.open(path) as gif:
        total = getattr(gif, "n_frames", 1)
        count = min(total, GIF_MAX_FRAMES)
        step = total / count
        canvas = Image.new("RGBA", gif.size, (0, 0, 0, 255))
        frames = []
        wanted = {int(i * step) for i in range(count)}
        for index in range(total):
            gif.seek(index)
            layer = gif.convert("RGBA")
            canvas.alpha_composite(layer)
            if index in wanted:
                frames.append(_fit(canvas, GIF_SIZE, place))
            if getattr(gif, "disposal_method", 0) == 2:
                canvas = Image.new("RGBA", gif.size, (0, 0, 0, 255))
    delay = int(GIF_FRAME_MS * step)
    return upload_reports(frames, GIF_SIZE, delay)


