def load_layout():
    with open(os.path.join(HERE, "rt100-layout.json")) as fh:
        return json.load(fh)


_HEX = re.compile(r"(?:#|rgba?\()([0-9A-Fa-f]{6})(?:[0-9A-Fa-f]{2})?")


def theme_border_colors():
    """The active window border colours (one, or a gradient's stops)."""
    try:
        with open(os.path.join(THEME_DIR, "hyprland.lua")) as fh:
            text = fh.read()
        match = re.search(r"active_border_color\s*=\s*(\{[^}]*\}[^\n]*|[^\n]+)", text)
        if match:
            colors = _HEX.findall(match.group(1))
            if colors:
                return ["#" + c.lower() for c in colors]
    except OSError:
        pass
    for name, pattern in (("keyboard.rgb", r"#?([0-9A-Fa-f]{6})"),
                          ("colors.toml", r'accent\s*=\s*"#([0-9A-Fa-f]{6})"')):
        try:
            with open(os.path.join(THEME_DIR, name)) as fh:
                found = re.search(pattern, fh.read())
            if found:
                return ["#" + found.group(1).lower()]
        except OSError:
            pass
    return ["#ffffff"]


def _rgb(hex_color):
    value = hex_color.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def gradient_colors(layout, stops):
    """Spread colour stops across the keyboard from left to right."""
    colors = [_rgb(c) for c in stops]
    lit = [k for k in layout if k["led"] >= 0]      # numpad Enter has no light
    if len(colors) == 1:
        return {k["led"]: colors[0] for k in lit}
    right = max(k["x"] + k["w"] for k in layout)
    result = {}
    for key in lit:
        t = (key["x"] + key["w"] / 2) / right * (len(colors) - 1)
        i = min(int(t), len(colors) - 2)
        f = t - i
        a, b = colors[i], colors[i + 1]
        result[key["led"]] = tuple(round(a[c] + (b[c] - a[c]) * f) for c in range(3))
    return result


def theme_signature():
    parts = []
    for name in ("hyprland.lua", "keyboard.rgb", "colors.toml"):
        try:
            st = os.stat(os.path.join(THEME_DIR, name))
            parts.append("%s:%d:%d" % (name, st.st_mtime_ns, st.st_ino))
        except OSError:
            parts.append(name + ":-")
    try:
        parts.append(os.path.realpath(THEME_DIR))
    except OSError:
        pass
    return "|".join(parts)


def _temp_input():
    """Path of the CPU package temperature, best source first."""
    preferred = (("coretemp", "Package id 0"), ("k10temp", "Tctl"), ("zenpower", "Tdie"))
    for chip, label in preferred:
        for hwmon in glob.glob("/sys/class/hwmon/hwmon*"):
            try:
                if open(os.path.join(hwmon, "name")).read().strip() != chip:
                    continue
            except OSError:
                continue
            for lab in glob.glob(os.path.join(hwmon, "temp*_label")):
                try:
                    if open(lab).read().strip() == label:
                        return lab.replace("_label", "_input")
                except OSError:
                    pass
            first = os.path.join(hwmon, "temp1_input")
            if os.path.exists(first):
                return first
    for zone in glob.glob("/sys/class/thermal/thermal_zone*"):
        try:
            if open(os.path.join(zone, "type")).read().strip() == "x86_pkg_temp":
                return os.path.join(zone, "temp")
        except OSError:
            pass
    return None


def read_temp(path):
    try:
        with open(path) as fh:
            return max(1, min(99, round(int(fh.read()) / 1000)))
    except (OSError, ValueError, TypeError):
        return None


class CpuMeter:
    def __init__(self):
        self.last = self._sample()

    @staticmethod
    def _sample():
        with open("/proc/stat") as fh:
            fields = [int(v) for v in fh.readline().split()[1:]]
        idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
        return idle, sum(fields)

    def percent(self):
        idle, total = self._sample()
        d_idle, d_total = idle - self.last[0], total - self.last[1]
        self.last = (idle, total)
        if d_total <= 0:
            return 0
        return max(0, min(99, round(100 * (d_total - d_idle) / d_total)))


SETTINGS_PATH = os.path.join(STATE_DIR, "settings.json")


def load_settings():
    try:
        with open(SETTINGS_PATH) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
